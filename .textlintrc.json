{
  "//": "Zenn 向けの校正設定。process-compass(規程文書)の設定とは別物として設計している。詳細は docs/textlint.md",
  "plugins": {
    "@textlint/markdown": {
      "extensions": [
        ".md"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [
          ":",
          "——",
          "—"
        ],
        "allowEmojiAtEnd": true
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "ですます",
        "preferInList": "",
        "strict": false
      },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": false,
      "max-comma": {
        "max": 5
      },
      "max-ten": {
        "max": 3
      },
      "max-kanji-continuous-len": {
        "max": 6
      },
      "no-doubled-joshi": {
        "min_interval": 1,
        "strict": false,
        "allow": []
      }
    },
    "@textlint-rule/pattern": {
      "patterns": [
        {
          "message": "ハングル・韓国語の文字が含まれています。日本語（的など）に修正してください。",
          "pattern": "/[\\uac00-\\ud7a3\\u1100-\\u11ff\\u3130-\\u318f]/u"
        }
      ]
    }
  }
}